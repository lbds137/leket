{
  "manifest_version": 3,
  "name": "Leket",
  "version": "0.18.2",
  "minimum_chrome_version": "109",
  "description": "Save Discord and Messenger conversations with their attachments, Etsy conversations, Reddit posts, claude.ai sessions, Replika chats and YouTube transcripts and comments as files you keep.",
  "action": {
    "default_title": "Leket",
    "default_popup": "src/popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "permissions": ["scripting", "downloads", "offscreen"],
  "host_permissions": [
    "https://discord.com/*",
    "https://cdn.discordapp.com/*",
    "https://media.discordapp.net/*",
    "https://www.messenger.com/*",
    "https://www.facebook.com/*",
    "https://www.reddit.com/*",
    "https://old.reddit.com/*",
    "https://i.redd.it/*",
    "https://preview.redd.it/*",
    "https://external-preview.redd.it/*",
    "https://claude.ai/*",
    "https://www.etsy.com/*",
    "https://etsy.com/*",
    "https://www.youtube.com/*",
    "https://my.replika.com/*",
    "https://my.replika.ai/*",
    "wss://ws.replika.com/*",
    "https://s3-us-west-1.amazonaws.com/replika-content-images/*",
    "https://luka-user-media.s3.us-west-1.amazonaws.com/*"
  ]
}
